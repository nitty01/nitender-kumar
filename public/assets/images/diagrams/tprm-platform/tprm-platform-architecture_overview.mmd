---
config:
  flowchart:
    nodeSpacing: 48
    rankSpacing: 64
    diagramPadding: 16
    htmlLabels: false
    curve: linear
  layout: dagre
---
flowchart TB
  SN["ServiceNow"]
  subgraph EDGE["Public edge"]
    WAF["APIM + WAF"]
    KV["Entra + Key Vault"]
  end
  subgraph VNET["Azure VNet"]
    ORCH["Orchestration + agents"]
    COSMOS[("Cosmos + Private Link")]
    BLOB[("Blob evidence")]
  end
  SN --> WAF
  WAF --> ORCH
  ORCH --> COSMOS
  ORCH --> BLOB
  ORCH -.->|async callback| SN
  KV -.-> WAF
  class SN external
  class ORCH compute
  class COSMOS,BLOB data
  class WAF,KV security
  classDef compute fill:#ccfbf1,stroke:#0f766e,stroke-width:1.5px,color:#042f2e
  classDef data fill:#dbeafe,stroke:#1d4ed8,stroke-width:1.5px,color:#1e3a8a
  classDef security fill:#fef3c7,stroke:#b45309,stroke-width:1.5px,color:#78350f
  classDef external fill:#f8fafc,stroke:#64748b,stroke-width:1.5px,color:#0f172a,stroke-dasharray:6 4
