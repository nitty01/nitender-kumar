flowchart LR
  FLEET["500K+ vehicles"]
  MKT["Ads / Salesforce"]
  subgraph EDGE["Control plane"]
    IAM["IAM + KMS"]
  end
  subgraph VPC["AWS VPC"]
    KIN["Kinesis ingest"]
    GLUE["Glue Streaming"]
    ICE[("Iceberg on S3")]
    RS[("Redshift private")]
    SM["SageMaker MLOps"]
  end
  DASH["Self-service analytics"]
  FLEET --> KIN
  MKT --> KIN
  KIN --> GLUE
  GLUE --> ICE
  ICE --> RS
  ICE --> SM
  RS --> DASH
  SM --> DASH
  IAM -.-> GLUE
  class FLEET,MKT external
  class KIN,GLUE,SM,DASH compute
  class ICE,RS data
  class IAM security
  classDef compute fill:#ccfbf1,stroke:#0f766e,stroke-width:1.5px,color:#042f2e
  classDef data fill:#dbeafe,stroke:#1d4ed8,stroke-width:1.5px,color:#1e3a8a
  classDef security fill:#fef3c7,stroke:#b45309,stroke-width:1.5px,color:#78350f
