---
config:
  flowchart:
    nodeSpacing: 48
    rankSpacing: 64
    diagramPadding: 16
    htmlLabels: false
    curve: linear
  layout: dagre
---
flowchart LR
  IOT["IoT devices"]
  subgraph DMZ["DMZ"]
    GW["API gateway"]
    AUTH["AuthN / AuthZ"]
  end
  subgraph APPZ["App zone"]
    BUS["Kafka + MQTT"]
    STREAM["Spark / Flink"]
  end
  subgraph DATAZ["Data zone"]
    HDFS[("HDFS + HBase")]
  end
  OPS["Operations dashboards"]
  IOT --> GW
  GW --> BUS
  BUS --> STREAM
  STREAM --> HDFS
  HDFS --> OPS
  AUTH -.-> GW
  class IOT external
  class BUS,STREAM,OPS compute
  class HDFS data
  class GW,AUTH security
  classDef compute fill:#ccfbf1,stroke:#0f766e,stroke-width:1.5px,color:#042f2e
  classDef data fill:#dbeafe,stroke:#1d4ed8,stroke-width:1.5px,color:#1e3a8a
  classDef security fill:#fef3c7,stroke:#b45309,stroke-width:1.5px,color:#78350f
  classDef external fill:#f8fafc,stroke:#64748b,stroke-width:1.5px,color:#0f172a,stroke-dasharray:6 4
