---
config:
  flowchart:
    nodeSpacing: 48
    rankSpacing: 64
    diagramPadding: 16
    htmlLabels: false
    curve: linear
  layout: dagre
---
flowchart LR
  CAM["Live video feeds"]
  subgraph EDGE["Public edge"]
    WAF["ALB + WAF"]
    IAM["IAM + KMS"]
  end
  subgraph VPC["AWS VPC"]
    CV["OpenCV + TensorFlow"]
    Q["Queue length"]
    PG[("PostgreSQL")]
    DASH["Supervisor dashboard"]
  end
  CAM --> WAF
  WAF --> CV
  CV --> Q
  Q --> PG
  Q --> DASH
  PG --> DASH
  IAM -.-> CV
  class CAM external
  class CV,Q,DASH compute
  class PG data
  class WAF,IAM security
  classDef compute fill:#ccfbf1,stroke:#0f766e,stroke-width:1.5px,color:#042f2e
  classDef data fill:#dbeafe,stroke:#1d4ed8,stroke-width:1.5px,color:#1e3a8a
  classDef security fill:#fef3c7,stroke:#b45309,stroke-width:1.5px,color:#78350f
  classDef external fill:#f8fafc,stroke:#64748b,stroke-width:1.5px,color:#0f172a,stroke-dasharray:6 4
