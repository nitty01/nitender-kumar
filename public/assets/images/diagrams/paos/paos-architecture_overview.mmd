---
config:
  flowchart:
    nodeSpacing: 48
    rankSpacing: 64
    diagramPadding: 16
    htmlLabels: false
    curve: linear
  layout: dagre
---
flowchart LR
  MGR["Retail and inventory teams"]
  subgraph DMZ["DMZ"]
    GW["Reverse proxy"]
    AUTH["AuthN / AuthZ"]
  end
  subgraph APPZ["App zone"]
    SPARK["Spark + Hadoop"]
    ML["Demand forecast"]
  end
  subgraph DATAZ["Data zone"]
    STORE[("SQL + Hadoop")]
  end
  DASH["Demand dashboard"]
  MGR --> GW
  GW --> AUTH
  AUTH --> SPARK
  SPARK --> ML
  SPARK --> STORE
  STORE --> DASH
  class MGR external
  class SPARK,ML,DASH compute
  class STORE data
  class GW,AUTH security
  classDef compute fill:#ccfbf1,stroke:#0f766e,stroke-width:1.5px,color:#042f2e
  classDef data fill:#dbeafe,stroke:#1d4ed8,stroke-width:1.5px,color:#1e3a8a
  classDef security fill:#fef3c7,stroke:#b45309,stroke-width:1.5px,color:#78350f
  classDef external fill:#f8fafc,stroke:#64748b,stroke-width:1.5px,color:#0f172a,stroke-dasharray:6 4
